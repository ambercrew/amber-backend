{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=127.0.0.1;Database=default;Username=postgres;Trust Server Certificate=true"
  },
  "SyncConfigurations": {
    "SyncedEntitiesPageSize": 50,
    "MaxStoragePerUserInBytes": 100000000
  },
  "GlobalRateLimiterConfiguration": {
    "QueueLimit": 1,
    "TokenLimit": 80,
    "TokensPerPeriod": 80,
    "ReplenishmentPeriodInSeconds": 60
  },
  "AuthRateLimiterConfiguration": {
    "QueueLimit": 1,
    "TokenLimit": 10,
    "TokensPerPeriod": 5,
    "ReplenishmentPeriodInSeconds": 60
  },
  "Lettermint": {
    "ApiKey": "Set via dotnet user-secrets"
  },
  "Jwt": {
    "SecretKey": "Set via dotnet user-secrets - must be at least 32 characters",
    "Issuer": "Amber",
    "Audience": "Amber",
    "ExpiryInDays": 60
  }
}
